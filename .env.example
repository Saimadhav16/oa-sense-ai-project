# OA-Sense AI Environment Variables Configuration
# Copy this file to .env and adjust values for your environment.
# IMPORTANT: Never commit .env to GitHub or share private secret keys!

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/oasense.db

# Authentication Security (Change SECRET_KEY in production!)
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated origins, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Demo User Credentials (Initialized on startup)
DEMO_USER_EMAIL=demo@oasense.ai
DEMO_USER_PASSWORD=demo123

# Frontend API Target (Set to your deployed backend URL in production)
VITE_API_BASE_URL=http://127.0.0.1:8000
