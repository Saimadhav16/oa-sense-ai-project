# Environment & Secrets (NEVER COMMIT SECRETS OR APIS)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local

# Database & Patient Reports (Protects patient privacy & prevents binary diffs)
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
!backend/data/.gitkeep
backend/reports/*.pdf
!backend/reports/.gitkeep

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
